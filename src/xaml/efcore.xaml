<!-- THE EF CORE EDITION: the whole demo, driven by XAML. No code-behind, no converters, no event handlers.
     It uses the two model classes in DemoTimeCard.cs / DemoTimeCardContext.cs (EF Core + SQLite) and nothing else of ours.
     Dynamic values reach typed entity properties as RAW typed nodes: carrier array -> new String(char[]) -> Double/Int32.Parse,
     declared AFTER the providers that fill the carriers (XAML builds nodes in document order, so document order IS the program).
     The 40-hour stop rule is a SQL trigger, because a SQL string in XAML is still XAML. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
        xmlns:sql="clr-namespace:Microsoft.Data.Sqlite;assembly=Microsoft.Data.Sqlite"
        xmlns:m="clr-namespace:Challenge1;assembly=XamlChallenge1"
        Title="Only One STATEMENT (package-backed pure XAML, EF Core)" Width="520" Height="320" ResizeMode="NoResize">
<Window.Resources>
<sys:Random x:Key="rnd"><x:Arguments><sys:Int32>42</sys:Int32></x:Arguments></sys:Random>
<m:DemoTimeCardContext x:Key="ctx"/>
<sql:SqliteConnection x:Key="conn"><x:Arguments><sys:String>Data Source=data/demo-timecards.db</sys:String></x:Arguments></sql:SqliteConnection>
<ObjectDataProvider x:Key="open" ObjectInstance="{StaticResource conn}" MethodName="Open"/>
<sql:SqliteCommand x:Key="guardCmd"><x:Arguments><sys:String>CREATE TRIGGER IF NOT EXISTS DemoGuard AFTER INSERT ON TimeCards WHEN (SELECT COALESCE(SUM(Hours),0) FROM TimeCards WHERE Id &lt; NEW.Id) &gt; 40 BEGIN DELETE FROM TimeCards WHERE Id = NEW.Id; END</sys:String><StaticResource ResourceKey="conn"/></x:Arguments></sql:SqliteCommand>
<ObjectDataProvider x:Key="doGuard" ObjectInstance="{StaticResource guardCmd}" MethodName="ExecuteNonQuery"/>
<ObjectDataProvider x:Key="yrFmt" ObjectInstance="{x:Static sys:DateTime.Now}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>yyyy</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="yrChars" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<ObjectDataProvider x:Key="yrCopy" ObjectInstance="{StaticResource yrFmt}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="yrChars"/><sys:Int32>0</sys:Int32><sys:Int32>4</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="wkNum" ObjectType="{x:Type glob:ISOWeek}" MethodName="GetWeekOfYear"><ObjectDataProvider.MethodParameters><x:Static Member="sys:DateTime.Now"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="wkFmt" ObjectInstance="{StaticResource wkNum}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>00</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="wkChars" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<ObjectDataProvider x:Key="wkCopy" ObjectInstance="{StaticResource wkFmt}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="wkChars"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="next0" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="fmt0" ObjectInstance="{StaticResource next0}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="chars0" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<ObjectDataProvider x:Key="copy0" ObjectInstance="{StaticResource fmt0}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars0"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="next1" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="fmt1" ObjectInstance="{StaticResource next1}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="chars1" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<ObjectDataProvider x:Key="copy1" ObjectInstance="{StaticResource fmt1}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars1"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="next2" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="fmt2" ObjectInstance="{StaticResource next2}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="chars2" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<ObjectDataProvider x:Key="copy2" ObjectInstance="{StaticResource fmt2}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars2"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="next3" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="fmt3" ObjectInstance="{StaticResource next3}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="chars3" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<ObjectDataProvider x:Key="copy3" ObjectInstance="{StaticResource fmt3}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars3"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<sys:String x:Key="yrStr"><x:Arguments><StaticResource ResourceKey="yrChars"/></x:Arguments></sys:String>
<sys:Int32 x:Key="year" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="yrStr"/></x:Arguments></sys:Int32>
<sys:String x:Key="wkStr"><x:Arguments><StaticResource ResourceKey="wkChars"/></x:Arguments></sys:String>
<sys:Int32 x:Key="week" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="wkStr"/></x:Arguments></sys:Int32>
<sys:String x:Key="hStr0"><x:Arguments><StaticResource ResourceKey="chars0"/></x:Arguments></sys:String>
<sys:Double x:Key="hours0" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="hStr0"/></x:Arguments></sys:Double>
<m:DemoTimeCard x:Key="card0" Category="Meetings" UserId="DemoUser" IsDemo="True"><m:DemoTimeCard.Hours><StaticResource ResourceKey="hours0"/></m:DemoTimeCard.Hours><m:DemoTimeCard.Year><StaticResource ResourceKey="year"/></m:DemoTimeCard.Year><m:DemoTimeCard.Week><StaticResource ResourceKey="week"/></m:DemoTimeCard.Week></m:DemoTimeCard>
<sys:String x:Key="hStr1"><x:Arguments><StaticResource ResourceKey="chars1"/></x:Arguments></sys:String>
<sys:Double x:Key="hours1" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="hStr1"/></x:Arguments></sys:Double>
<m:DemoTimeCard x:Key="card1" Category="Coding" UserId="DemoUser" IsDemo="True"><m:DemoTimeCard.Hours><StaticResource ResourceKey="hours1"/></m:DemoTimeCard.Hours><m:DemoTimeCard.Year><StaticResource ResourceKey="year"/></m:DemoTimeCard.Year><m:DemoTimeCard.Week><StaticResource ResourceKey="week"/></m:DemoTimeCard.Week></m:DemoTimeCard>
<sys:String x:Key="hStr2"><x:Arguments><StaticResource ResourceKey="chars2"/></x:Arguments></sys:String>
<sys:Double x:Key="hours2" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="hStr2"/></x:Arguments></sys:Double>
<m:DemoTimeCard x:Key="card2" Category="Debugging" UserId="DemoUser" IsDemo="True"><m:DemoTimeCard.Hours><StaticResource ResourceKey="hours2"/></m:DemoTimeCard.Hours><m:DemoTimeCard.Year><StaticResource ResourceKey="year"/></m:DemoTimeCard.Year><m:DemoTimeCard.Week><StaticResource ResourceKey="week"/></m:DemoTimeCard.Week></m:DemoTimeCard>
<sys:String x:Key="hStr3"><x:Arguments><StaticResource ResourceKey="chars3"/></x:Arguments></sys:String>
<sys:Double x:Key="hours3" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="hStr3"/></x:Arguments></sys:Double>
<m:DemoTimeCard x:Key="card3" Category="Learning" UserId="DemoUser" IsDemo="True"><m:DemoTimeCard.Hours><StaticResource ResourceKey="hours3"/></m:DemoTimeCard.Hours><m:DemoTimeCard.Year><StaticResource ResourceKey="year"/></m:DemoTimeCard.Year><m:DemoTimeCard.Week><StaticResource ResourceKey="week"/></m:DemoTimeCard.Week></m:DemoTimeCard>
<ObjectDataProvider x:Key="sets" ObjectInstance="{StaticResource ctx}" MethodName="get_TimeCards"/>
<ObjectDataProvider x:Key="add0" ObjectInstance="{StaticResource sets}" MethodName="Add"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="card0"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="add1" ObjectInstance="{StaticResource sets}" MethodName="Add"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="card1"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="add2" ObjectInstance="{StaticResource sets}" MethodName="Add"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="card2"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="add3" ObjectInstance="{StaticResource sets}" MethodName="Add"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="card3"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="save" ObjectInstance="{StaticResource ctx}" MethodName="SaveChanges"/>
<sql:SqliteCommand x:Key="cnt"><x:Arguments><sys:String>SELECT COUNT(*) || ' cards, ' || SUM(Hours) || ' hours' FROM TimeCards</sys:String><StaticResource ResourceKey="conn"/></x:Arguments></sql:SqliteCommand>
<ObjectDataProvider x:Key="obsSummary" IsAsynchronous="True" ObjectInstance="{StaticResource cnt}" MethodName="ExecuteScalar"/>
</Window.Resources>
<Viewbox><Grid x:Name="g" Background="#172033" Width="520" Height="320">
  <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
    <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
  </Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
  <StackPanel Margin="28">
    <TextBlock Foreground="#FFCE56" FontWeight="Bold" FontSize="18" Text="DEMO ONLY - no real time system is involved"/>
    <TextBlock Foreground="White" FontSize="22" Text="{Binding Source={StaticResource obsSummary}, StringFormat='Saved via EF Core: {0}'}"/>
  </StackPanel>
</Grid></Viewbox>
</Window>
