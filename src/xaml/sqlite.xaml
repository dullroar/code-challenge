        xmlns:sql="clr-namespace:Microsoft.Data.Sqlite;assembly=Microsoft.Data.Sqlite"
        Title="Only One STATEMENT (package-backed pure XAML)" Width="520" Height="320" ResizeMode="NoResize">
<Window.Resources>
<sys:Random x:Key="rnd"><x:Arguments><sys:Int32>42</sys:Int32></x:Arguments></sys:Random>
<sql:SqliteConnection x:Key="conn"><x:Arguments><sys:String>Data Source=data/sqlite-timecards.db</sys:String></x:Arguments></sql:SqliteConnection>
<ObjectDataProvider x:Key="open" ObjectInstance="{StaticResource conn}" MethodName="Open"/>
<sql:SqliteCommand x:Key="ddl"><x:Arguments><sys:String>CREATE TABLE IF NOT EXISTS DemoTimeCards(Id INTEGER PRIMARY KEY, Category TEXT NOT NULL, Hours REAL, UserId TEXT, Year INTEGER, Week INTEGER, IsDemo INTEGER NOT NULL)</sys:String><StaticResource ResourceKey="conn"/></x:Arguments></sql:SqliteCommand>
<ObjectDataProvider x:Key="doDdl" ObjectInstance="{StaticResource ddl}" MethodName="ExecuteNonQuery"/>
<ObjectDataProvider x:Key="next0" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="fmt0" ObjectInstance="{StaticResource next0}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="chars0" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<x:Array x:Key="bytes0" Type="{x:Type sys:Byte}"><sys:Byte>0</sys:Byte><sys:Byte>0</sys:Byte></x:Array>
<ObjectDataProvider x:Key="copy0" ObjectInstance="{StaticResource fmt0}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars0"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="enc0" ObjectInstance="{x:Static txt:Encoding.ASCII}" MethodName="GetBytes"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="chars0"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32><StaticResource ResourceKey="bytes0"/><sys:Int32>0</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<sql:SqliteParameter x:Key="p0"><x:Arguments><sys:String>@h</sys:String><StaticResource ResourceKey="bytes0"/></x:Arguments></sql:SqliteParameter>
<sql:SqliteCommand x:Key="ins0"><x:Arguments><sys:String>INSERT INTO DemoTimeCards(Category,Hours,UserId,Year,Week,IsDemo) SELECT 'Meetings', CAST(@h AS INTEGER), 'DemoUser', CAST(strftime('%Y','now') AS INTEGER), CAST(strftime('%W','now') AS INTEGER), 1 WHERE (SELECT COALESCE(SUM(Hours),0) FROM DemoTimeCards) &lt;= 40</sys:String><StaticResource ResourceKey="conn"/></x:Arguments></sql:SqliteCommand>
<ObjectDataProvider x:Key="params0" ObjectInstance="{StaticResource ins0}" MethodName="get_Parameters"/>
<ObjectDataProvider x:Key="addp0" ObjectInstance="{StaticResource params0}" MethodName="Add"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="p0"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="doIns0" ObjectInstance="{StaticResource ins0}" MethodName="ExecuteNonQuery"/>
<ObjectDataProvider x:Key="next1" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<ObjectDataProvider x:Key="fmt1" ObjectInstance="{StaticResource next1}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
<x:Array x:Key="chars1" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
<x:Array x:Key="bytes1" Type="{x:Type sys:Byte}"><sys:Byte>0</sys:Byte><sys:Byte>0</sys:Byte></x:Array>
