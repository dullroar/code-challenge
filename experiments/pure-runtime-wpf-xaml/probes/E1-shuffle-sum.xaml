<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:linq="clr-namespace:System.Linq;assembly=System.Linq" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <sys:Random x:Key="rnd"><x:Arguments><sys:Int32>42</sys:Int32></x:Arguments></sys:Random>
    <x:Array x:Key="hours" Type="{x:Type sys:Int32}"><sys:Int32>10</sys:Int32><sys:Int32>11</sys:Int32><sys:Int32>12</sys:Int32><sys:Int32>13</sys:Int32><sys:Int32>14</sys:Int32></x:Array>
    <ObjectDataProvider x:Key="shuffle" ObjectInstance="{StaticResource rnd}" MethodName="Shuffle"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="hours"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="sum" ObjectType="{x:Type linq:Enumerable}" MethodName="Sum"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="hours"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="cmp" ObjectInstance="{StaticResource sum}" MethodName="CompareTo"><ObjectDataProvider.MethodParameters><sys:Int32>40</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
  </Window.Resources>
</Window>
