<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:thr="clr-namespace:System.Threading;assembly=System.Threading.Thread"
        xmlns:col="clr-namespace:System.Collections;assembly=System.Runtime"
        xmlns:sb="clr-namespace:System.Text;assembly=System.Runtime" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <sb:StringBuilder x:Key="log"/>
    <!-- delegate over a built-in void() instance method: StringBuilder.Clear returns SB (not void) so use ArrayList.Clear (void) -->
    <col:ArrayList x:Key="target"/>
    <ObjectDataProvider x:Key="mkDelegate" ObjectType="{x:Type sys:Delegate}" MethodName="CreateDelegate">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="thr:ThreadStart"/>
        <StaticResource ResourceKey="target"/>
        <sys:String>Clear</sys:String>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>
</Window>
