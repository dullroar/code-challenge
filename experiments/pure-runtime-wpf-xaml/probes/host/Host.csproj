<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- makes the experiment model assembly resolvable by name from runtime XAML (deps.json); host stays generic -->
    <ProjectReference Include="../../package-backed-ef/model/EfModel.csproj" />
  </ItemGroup>
</Project>
