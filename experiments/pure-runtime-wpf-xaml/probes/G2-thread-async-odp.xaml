<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:thr="clr-namespace:System.Threading;assembly=System.Threading.Thread"
        xmlns:col="clr-namespace:System.Collections;assembly=System.Runtime" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <ObjectDataProvider x:Key="tidSync" ObjectType="{x:Type sys:Environment}" MethodName="get_CurrentManagedThreadId"/>
    <ObjectDataProvider x:Key="tidAsync" IsAsynchronous="True" ObjectType="{x:Type sys:Environment}" MethodName="get_CurrentManagedThreadId"/>
    <!-- explicit Thread: ThreadStart over a void instance method (ArrayList.Clear), IsBackground set in XAML, started by ODP -->
    <col:ArrayList x:Key="target"><sys:String>a</sys:String><sys:String>b</sys:String></col:ArrayList>
    <sys:Delegate x:Key="mkDelegate" x:FactoryMethod="CreateDelegate"><x:Arguments><x:Type TypeName="thr:ThreadStart"/><StaticResource ResourceKey="target"/><sys:String>Clear</sys:String></x:Arguments></sys:Delegate>
    <thr:Thread x:Key="bg" IsBackground="True"><x:Arguments><StaticResource ResourceKey="mkDelegate"/></x:Arguments></thr:Thread>
    <ObjectDataProvider x:Key="infoBg" ObjectInstance="{StaticResource bg}" MethodName="get_ManagedThreadId"/>
    <ObjectDataProvider x:Key="infoBg2" ObjectInstance="{StaticResource bg}" MethodName="get_IsBackground"/>
    <ObjectDataProvider x:Key="startBg" ObjectInstance="{StaticResource bg}" MethodName="Start"/>
    <ObjectDataProvider x:Key="joinBg" ObjectInstance="{StaticResource bg}" MethodName="Join"/>
    <ObjectDataProvider x:Key="targetCount" ObjectInstance="{StaticResource target}" MethodName="get_Count"/>
  </Window.Resources>
</Window>
