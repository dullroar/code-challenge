<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:linq="clr-namespace:System.Linq;assembly=System.Linq" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <x:Array x:Key="hours" Type="{x:Type sys:Int32}"><sys:Int32>16</sys:Int32><sys:Int32>11</sys:Int32><sys:Int32>14</sys:Int32></x:Array>
    <ObjectDataProvider x:Key="sum" ObjectType="{x:Type linq:Enumerable}" MethodName="Sum"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="hours"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="vs40" ObjectInstance="{StaticResource sum}" MethodName="CompareTo"><ObjectDataProvider.MethodParameters><sys:Int32>40</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
  </Window.Resources>
  <TextBlock x:Name="obsT" Tag="{Binding Source={StaticResource vs40}}">
    <TextBlock.Style><Style TargetType="TextBlock">
      <Setter Property="Text" Value="initial"/><Style.Triggers>
        <DataTrigger Binding="{Binding Source={StaticResource vs40}}"><DataTrigger.Value><sys:Int32>1</sys:Int32></DataTrigger.Value><Setter Property="Text" Value="OVER-40: terminal"/></DataTrigger>
        <DataTrigger Binding="{Binding Source={StaticResource vs40}}"><DataTrigger.Value><sys:Int32>-1</sys:Int32></DataTrigger.Value><Setter Property="Text" Value="UNDER-40: continue"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
</Window>
