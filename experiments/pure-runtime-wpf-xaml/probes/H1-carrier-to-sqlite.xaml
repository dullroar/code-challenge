<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:txt="clr-namespace:System.Text;assembly=System.Runtime"
        xmlns:sql="clr-namespace:Microsoft.Data.Sqlite;assembly=Microsoft.Data.Sqlite" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <sys:Random x:Key="rnd"><x:Arguments><sys:Int32>42</sys:Int32></x:Arguments></sys:Random>
    <!-- 1. dynamic int (seeded) -->
    <ObjectDataProvider x:Key="next" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <!-- 2. receiver-dynamic: int -> "16" -->
    <ObjectDataProvider x:Key="fmt" ObjectInstance="{StaticResource next}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <!-- 3. carriers: char[2], byte[2] (raw, mutable) -->
    <x:Array x:Key="chars" Type="{x:Type sys:Char}"><sys:Char>x</sys:Char><sys:Char>x</sys:Char></x:Array>
    <x:Array x:Key="bytes" Type="{x:Type sys:Byte}"><sys:Byte>0</sys:Byte><sys:Byte>0</sys:Byte></x:Array>
    <!-- 4. dynamic string receiver writes into the char[] carrier -->
    <ObjectDataProvider x:Key="copy" ObjectInstance="{StaticResource fmt}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <!-- 5. ASCII.GetBytes(char[],0,2,byte[],0) into the byte[] carrier -->
    <ObjectDataProvider x:Key="enc" ObjectInstance="{x:Static txt:Encoding.ASCII}" MethodName="GetBytes"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="chars"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32><StaticResource ResourceKey="bytes"/><sys:Int32>0</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <!-- 6. SQLite -->
    <sql:SqliteConnection x:Key="conn"><x:Arguments><sys:String>Data Source=h1.db</sys:String></x:Arguments></sql:SqliteConnection>
    <ObjectDataProvider x:Key="open" ObjectInstance="{StaticResource conn}" MethodName="Open"/>
    <sql:SqliteCommand x:Key="ddl"><x:Arguments><sys:String>CREATE TABLE T(h INTEGER)</sys:String><StaticResource ResourceKey="conn"/></x:Arguments></sql:SqliteCommand>
    <ObjectDataProvider x:Key="doDdl" ObjectInstance="{StaticResource ddl}" MethodName="ExecuteNonQuery"/>
    <sql:SqliteParameter x:Key="p"><x:Arguments><sys:String>@h</sys:String><StaticResource ResourceKey="bytes"/></x:Arguments></sql:SqliteParameter>
    <sql:SqliteCommand x:Key="ins"><x:Arguments><sys:String>INSERT INTO T(h) VALUES (CAST(@h AS INTEGER))</sys:String><StaticResource ResourceKey="conn"/></x:Arguments></sql:SqliteCommand>
    <ObjectDataProvider x:Key="getParams" ObjectInstance="{StaticResource ins}" MethodName="get_Parameters"/>
    <ObjectDataProvider x:Key="addParam" ObjectInstance="{StaticResource getParams}" MethodName="Add"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="p"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="doIns" ObjectInstance="{StaticResource ins}" MethodName="ExecuteNonQuery"/>
  </Window.Resources>
</Window>
