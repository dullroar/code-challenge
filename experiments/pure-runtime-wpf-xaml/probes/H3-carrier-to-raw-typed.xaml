<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <sys:Random x:Key="rnd"><x:Arguments><sys:Int32>42</sys:Int32></x:Arguments></sys:Random>
    <ObjectDataProvider x:Key="next" ObjectInstance="{StaticResource rnd}" MethodName="Next"><ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="fmt" ObjectInstance="{StaticResource next}" MethodName="ToString"><ObjectDataProvider.MethodParameters><sys:String>0</sys:String></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <x:Array x:Key="chars" Type="{x:Type sys:Char}"><sys:Char>0</sys:Char><sys:Char>0</sys:Char></x:Array>
    <ObjectDataProvider x:Key="copy" ObjectInstance="{StaticResource fmt}" MethodName="CopyTo"><ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32><StaticResource ResourceKey="chars"/><sys:Int32>0</sys:Int32><sys:Int32>2</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <!-- constructed AFTER the carrier was filled (document order): raw string, then raw typed double -->
    <sys:String x:Key="rawStr"><x:Arguments><StaticResource ResourceKey="chars"/></x:Arguments></sys:String>
    <sys:Double x:Key="rawDouble" x:FactoryMethod="Parse"><x:Arguments><StaticResource ResourceKey="rawStr"/></x:Arguments></sys:Double>
    <ObjectDataProvider x:Key="obsType" ObjectInstance="{StaticResource rawDouble}" MethodName="GetType"/>
    <ObjectDataProvider x:Key="obsPlus1" ObjectInstance="{StaticResource rawDouble}" MethodName="CompareTo"><ObjectDataProvider.MethodParameters><sys:Double>15.5</sys:Double></ObjectDataProvider.MethodParameters></ObjectDataProvider>
  </Window.Resources>
</Window>
