<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <sys:Random x:Key="rnd"><x:Arguments><sys:Int32>42</sys:Int32></x:Arguments></sys:Random>
    <ObjectDataProvider x:Key="next" ObjectInstance="{StaticResource rnd}" MethodName="Next">
      <ObjectDataProvider.MethodParameters><sys:Int32>10</sys:Int32><sys:Int32>20</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <!-- smuggle the provider inside an array so it is not unwrapped -->
    <x:Array x:Key="holder" Type="{x:Type ObjectDataProvider}"><StaticResource ResourceKey="next"/></x:Array>
    <ObjectDataProvider x:Key="getter" ObjectInstance="{StaticResource holder}" MethodName="GetValue">
      <ObjectDataProvider.MethodParameters><sys:Int32>0</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="again" ObjectInstance="{StaticResource getter}" MethodName="Refresh"/>
  </Window.Resources>
</Window>
