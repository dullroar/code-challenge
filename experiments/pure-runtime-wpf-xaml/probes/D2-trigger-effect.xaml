<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:col="clr-namespace:System.Collections;assembly=System.Runtime"
        xmlns:linq="clr-namespace:System.Linq;assembly=System.Linq" Width="10" Height="10" ShowActivated="False">
  <Window.Resources>
    <x:Array x:Key="hours" Type="{x:Type sys:Int32}"><sys:Int32>16</sys:Int32><sys:Int32>11</sys:Int32><sys:Int32>14</sys:Int32></x:Array>
    <ObjectDataProvider x:Key="sum" ObjectType="{x:Type linq:Enumerable}" MethodName="Sum"><ObjectDataProvider.MethodParameters><StaticResource ResourceKey="hours"/></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <ObjectDataProvider x:Key="vs40" ObjectInstance="{StaticResource sum}" MethodName="CompareTo"><ObjectDataProvider.MethodParameters><sys:Int32>40</sys:Int32></ObjectDataProvider.MethodParameters></ObjectDataProvider>
    <col:ArrayList x:Key="target"><sys:String>pending</sys:String><sys:String>pending</sys:String></col:ArrayList>
    <ObjectDataProvider x:Key="act" ObjectInstance="{StaticResource target}" MethodName="get_Count"/>
    <x:Array x:Key="holder" Type="{x:Type ObjectDataProvider}"><StaticResource ResourceKey="act"/></x:Array>
  </Window.Resources>
  <TextBlock Text="x" Tag="{Binding Source={StaticResource holder}, Path=[0].MethodName, Mode=OneWayToSource}">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
      <DataTrigger Binding="{Binding Source={StaticResource vs40}}"><DataTrigger.Value><sys:Int32>1</sys:Int32></DataTrigger.Value>
        <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
          <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Tag"><DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Clear"/></ObjectAnimationUsingKeyFrames>
        </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
      </DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
</Window>
